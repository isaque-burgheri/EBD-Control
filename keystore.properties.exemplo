# Modelo do keystore.properties (que NAO entra no git).
#
# Copie este arquivo para `keystore.properties` na raiz do projeto e preencha as
# senhas. Sem ele o Gradle ainda compila, mas o APK de release sai sem assinatura.
#
# Perder o .jks ou a senha significa que nenhuma versao futura instala por cima:
# guarde os dois num gerenciador de senhas e faca backup do .jks fora da maquina.

storeFile=C:/Users/Administrator/ebd-release.jks
storePassword=
keyAlias=ebd
keyPassword=
